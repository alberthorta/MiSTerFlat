#!/bin/bash
# Start/stop MiSTerManager. Called from /media/fat/linux/user-startup.sh at boot.

DIR="$(cd "$(dirname "$0")" && pwd)"
PIDFILE="/run/mistermanager.pid"
LOG="/tmp/mistermanager.log"

running() { [ -e "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if running; then
    echo "mistermanager already running"
    return 0
  fi
  echo "Starting mistermanager..."
  cd "$DIR" && nohup python3 -m mistermanager >"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if running; then
    echo "Stopping mistermanager..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
  fi
  rm -f "$PIDFILE"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.5; start ;;
  status) if running; then echo "running (pid $(cat "$PIDFILE"))"; else echo "stopped"; exit 1; fi ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
